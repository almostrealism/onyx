---
// The centerpiece illustration: the detailed monitor on a busy day.
// Everything in it is invented sample data drawn with CSS — it isn't a
// screenshot, and the caption says so — but every row is a kind of row
// the app draws, and the numbers are the kind people actually run.
const claudes = [
  { host: 'workstation', session: 'api', tool: 'Edit', input: 'src/ingest/retry.ts', age: 'now' },
  { host: 'workstation', session: 'billing', permission: 'Bash — terraform apply', age: '0:12' },
  { host: 'build-02', session: 'infra', tool: 'Bash', input: 'terraform plan -out=tf.plan', age: '3s', more: 1 },
  { host: 'workstation', session: 'console', tool: 'Read', input: 'app/routes/settings.tsx', age: '8s' },
  { host: 'gpu-01', session: 'evals', tool: 'Bash', input: 'pytest -k regression', age: '41s' },
  { host: 'gpu-02', session: 'sweep', tool: 'Write', input: 'configs/lr-sweep.yaml', age: '1m' },
  { host: 'build-02', session: 'docs', idle: 'waiting for you', age: '6m' },
  { host: 'laptop', session: 'notes', idle: 'waiting for you', age: '22m' },
];

const prs = [
  {
    ref: 'acme/api#412', title: 'Retry policy for the ingest queue', threads: 3, ready: false,
    ci: { state: 'running', text: 'CI · integration' },
    labels: [{ name: 'agent: ready for review', color: '#c06bff' }],
  },
  {
    ref: 'acme/console#98', title: 'Billing settings page', threads: 0, ready: false,
    ci: { state: 'failed', text: 'CI · failed: e2e (chrome), e2e (safari)' },
    labels: [{ name: 'needs-human', color: '#ff6b6b' }],
  },
  {
    ref: 'ml/evals!57', title: 'Cut eval time in half', threads: 1, ready: false, gitlab: true,
    ci: { state: 'running', text: 'eval · shard 3/8' },
    labels: [
      { name: 'agent: in progress', color: '#c06bff' },
      { name: 'perf', color: '#ffd06b' },
    ],
  },
  {
    ref: 'platform/infra!87', title: 'Terraform 1.9', threads: 0, ready: true, gitlab: true,
    ci: { state: 'passed', text: 'plan · passed' },
    labels: [{ name: 'approved-by-agent', color: '#6bff8e' }],
  },
  {
    ref: 'acme/api#409', title: 'Pin the runner image', threads: 0, ready: false,
    ci: { state: 'queued', text: 'CI · build-arm64 queued' },
    labels: [],
  },
];

const pipelines = [
  { mark: '✕', color: 'text-bad', name: 'deploy · prod', ref: 'main', meta: 'attempt 2 · migrate' },
  { mark: '◐', color: 'text-accent-primary', name: 'nightly evals', ref: 'main', meta: '5 of 9' },
  { mark: '◐', color: 'text-accent-primary', name: 'Cut eval time in half', ref: 'evals-shard', meta: '3 of 8' },
  { mark: '●', color: 'text-ok', name: 'release 4.2', ref: 'v4.2.0', meta: '11m 40s' },
  { mark: '●', color: 'text-ok', name: 'Terraform 1.9', ref: 'tf-1.9', meta: '2m 05s' },
];

const hosts = [
  { name: 'workstation', cpu: 47, gpu: 61, claudes: 3 },
  { name: 'build-02', cpu: 82, gpu: null, claudes: 2 },
  { name: 'gpu-01', cpu: 34, gpu: 97, claudes: 1 },
  { name: 'gpu-02', cpu: 29, gpu: 93, claudes: 1 },
  { name: 'laptop', cpu: 8, gpu: 4, claudes: 1 },
];

const ciColor = {
  running: 'text-accent-primary',
  queued: 'text-warn',
  failed: 'text-bad',
  passed: 'text-ok',
};
---

<section class="relative border-y border-border-subtle bg-bg-secondary/40">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
        Everything in flight, on one screen
      </h2>
      <p class="mt-4 text-text-secondary">
        One key and the overlay drops over the terminal, over anything, with every Claude
        on every machine, every open PR and the job its CI is on, every pipeline you're
        tracking, and how hard each machine is working. It's built for the day when that's
        eight agents, twenty-three PRs and five hosts, and it stays readable.
      </p>
    </div>

    <div class="mt-14 overflow-hidden rounded-2xl border border-border-subtle bg-bg-primary/90 shadow-2xl">
      <!-- Headline row -->
      <div
        class="flex flex-wrap items-center justify-between gap-3 border-b border-border-subtle px-4 py-3 font-mono text-xs sm:px-6 sm:py-4"
      >
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          {hosts.map((h, i) => <span class={i === 0 ? 'text-accent-primary' : 'text-text-muted'}>{h.name}</span>)}
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-text-muted">
          <span>14:20</span>
          <span class="text-text-secondary">CPU 47%</span>
          <span class="text-text-secondary">MEM 34.2 / 64 GB</span>
          <span class="text-text-secondary">GPU 61%</span>
        </div>
      </div>

      <div class="grid gap-px bg-border-subtle lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)_minmax(0,1fr)]">
        <!-- Claude sessions -->
        <div class="bg-bg-primary p-4 sm:p-6">
          <p class="font-mono text-[10px] tracking-[0.2em] text-accent-primary uppercase">
            Sessions &amp; their Claudes
          </p>
          <ul class="mt-4 space-y-3">
            {
              claudes.map((c) => (
                <li class="font-mono">
                  <p class="flex items-baseline gap-2 text-[11px]">
                    <span
                      class={`h-1.5 w-1.5 shrink-0 translate-y-[-1px] rounded-full ${c.permission ? 'bg-warn' : c.idle ? 'bg-claude/40' : 'bg-claude'}`}
                    />
                    <span class="text-text-primary/90">{c.session}</span>
                    <span class="text-[10px] text-text-muted">{c.host}</span>
                    <span class={`ml-auto text-[10px] ${c.permission ? 'text-warn' : 'text-text-muted'}`}>{c.age}</span>
                  </p>
                  {c.tool && (
                    <p class="mt-0.5 flex min-w-0 items-baseline gap-1.5 pl-3.5 text-[10px]">
                      <span class="text-claude/90">{c.tool}</span>
                      <span class="truncate text-text-muted">{c.input}</span>
                      {c.more && <span class="text-claude/60">+{c.more}</span>}
                    </p>
                  )}
                  {c.permission && (
                    <p class="mt-0.5 pl-3.5 text-[10px] text-warn">waiting for permission &middot; {c.permission}</p>
                  )}
                  {c.idle && <p class="mt-0.5 pl-3.5 text-[10px] text-text-muted">{c.idle}</p>}
                </li>
              ))
            }
          </ul>
          <p class="mt-5 border-t border-border-subtle pt-3 text-xs text-text-muted">
            Live from Claude Code's hooks on every host. Click one to land in its tmux session.
          </p>
        </div>

        <!-- Pull requests -->
        <div class="bg-bg-primary p-4 sm:p-6">
          <div class="flex items-baseline justify-between">
            <p class="font-mono text-[10px] tracking-[0.2em] text-accent-primary uppercase">
              Open pull requests
            </p>
            <p class="font-mono text-[10px] text-text-muted">23 &middot; 9 repos &middot; 2 forges</p>
          </div>
          <ul class="mt-4 space-y-4">
            {
              prs.map((pr) => (
                <li>
                  <p class="font-mono text-[10px] text-text-muted">
                    <span class="rounded bg-text-muted/15 px-1.5 py-0.5">{pr.gitlab ? 'GitLab' : 'GitHub'}</span>
                    <span class="ml-1.5">{pr.ref}</span>
                    {pr.ready ? (
                      <span class="ml-2 text-ok">ready to merge</span>
                    ) : pr.threads > 0 ? (
                      <span class="ml-2 text-warn">{pr.threads} unresolved</span>
                    ) : null}
                  </p>
                  <p class="mt-1 text-[13px] text-text-primary/90">{pr.title}</p>
                  <p class={`mt-0.5 font-mono text-[10px] ${ciColor[pr.ci.state]}`}>{pr.ci.text}</p>
                  {pr.labels.length > 0 && (
                    <div class="mt-1.5 flex flex-wrap gap-1">
                      {pr.labels.map((l) => (
                        <span
                          class="inline-flex items-center gap-1 rounded-[3px] border px-1.5 font-mono text-[9px] text-white/80"
                          style={`background:${l.color}2e;border-color:${l.color}8c`}
                        >
                          <span class="h-[6px] w-[6px] rounded-full" style={`background:${l.color}`} />
                          {l.name}
                        </span>
                      ))}
                    </div>
                  )}
                </li>
              ))
            }
          </ul>
          <p class="mt-5 border-t border-border-subtle pt-3 text-xs text-text-muted">
            Each with its own CI, from the workflows you picked.
          </p>
        </div>

        <!-- Pipelines + fleet -->
        <div class="bg-bg-primary p-4 sm:p-6">
          <p class="font-mono text-[10px] tracking-[0.2em] text-accent-primary uppercase">
            Tracked pipelines
          </p>
          <ul class="mt-4 space-y-2.5">
            {
              pipelines.map((p) => (
                <li class="font-mono text-[11px]">
                  <p class="flex items-baseline gap-2">
                    <span class={p.color}>{p.mark}</span>
                    <span class="min-w-0 truncate text-text-primary/90">{p.name}</span>
                    <span class={`ml-auto shrink-0 text-[10px] ${p.mark === '✕' ? 'text-bad' : 'text-text-muted'}`}>{p.meta}</span>
                  </p>
                  <p class="pl-4 text-[10px] text-text-muted">{p.ref}</p>
                </li>
              ))
            }
          </ul>

          <p class="mt-7 font-mono text-[10px] tracking-[0.2em] text-accent-primary uppercase">Fleet</p>
          <ul class="mt-4 space-y-2.5 font-mono text-[10px]">
            {
              hosts.map((h) => (
                <li>
                  <p class="flex items-baseline gap-2">
                    <span class="w-20 shrink-0 truncate text-text-secondary">{h.name}</span>
                    <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-border-subtle">
                      <span class="block h-full rounded-full bg-accent-primary/60" style={`width:${h.cpu}%`} />
                    </span>
                    <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-border-subtle">
                      {h.gpu !== null && (
                        <span class="block h-full rounded-full bg-claude/60" style={`width:${h.gpu}%`} />
                      )}
                    </span>
                  </p>
                </li>
              ))
            }
          </ul>
          <p class="mt-2 flex gap-4 font-mono text-[9px] text-text-muted">
            <span><span class="text-accent-primary">■</span> CPU</span>
            <span><span class="text-claude">■</span> GPU</span>
          </p>
          <p class="mt-5 border-t border-border-subtle pt-3 text-xs text-text-muted">
            Every host keeps being sampled, whichever one you're looking at.
          </p>
        </div>
      </div>
    </div>

    <p class="mt-4 text-center font-mono text-[11px] text-text-muted">
      The detailed monitor &middot; illustration with sample data
    </p>

    <!-- What makes the scale workable -->
    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-border-subtle bg-bg-primary/60 p-5">
        <p class="font-mono text-[10px] tracking-wide text-claude uppercase">Every Claude</p>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          Hooks install on every host and every account that runs Claude Code, in one click.
          Each Claude joins the tmux session it's running in and leaves when it quits, so
          the list is what's really running.
        </p>
      </div>
      <div class="rounded-xl border border-border-subtle bg-bg-primary/60 p-5">
        <p class="font-mono text-[10px] tracking-wide text-accent-primary uppercase">Every PR</p>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          Watch a whole GitHub owner or GitLab group, not a list of repos. Each PR carries
          its own CI, from the workflows you pick, with the job it's on and the jobs that
          failed named.
        </p>
      </div>
      <div class="rounded-xl border border-border-subtle bg-bg-primary/60 p-5">
        <p class="font-mono text-[10px] tracking-wide text-warn uppercase">What needs you first</p>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          A Claude waiting for permission pulses amber. Failed pipelines lead the list and
          say which attempt they're on. Busy PRs come before quiet ones. With several Claudes
          in a session, the one that needs you speaks.
        </p>
      </div>
      <div class="rounded-xl border border-border-subtle bg-bg-primary/60 p-5">
        <p class="font-mono text-[10px] tracking-wide text-ok uppercase">What your agents think</p>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          The PR labels you choose, typically the ones your agents leave, appear in their own
          colors: named in the overlay, a single dot where space is tight.
        </p>
      </div>
    </div>
  </div>
</section>
