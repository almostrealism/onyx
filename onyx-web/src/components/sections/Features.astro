<section class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
  <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Everything else it does</h2>

  <div class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2">
    {
      features.map((feature) => (
        <div class="border-l-2 border-border-subtle pl-5 transition hover:border-accent-primary/60">
          <h3 class="font-medium text-text-primary">{feature.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-text-secondary">{feature.body}</p>
        </div>
      ))
    }
  </div>
</section>
