---
// Consent-first analytics notice.
//
// Nothing is measured until someone actively chooses. Consent Mode v2
// carries the decision: the container loads with every storage category
// DENIED (set in Layout.astro before GTM, which is the only place it
// works — a default set after the container has started is too late), so
// until you accept, GTM sets no cookies and sends only cookieless pings.
//
// The two buttons are deliberately identical in size, weight and colour.
// "Reject as easy as accept" is the part that gets sites fined, and a
// quiet outline button next to a filled accent one is exactly the
// pattern being fined for.
---

<div
  id="consent-notice"
  role="dialog"
  aria-modal="false"
  aria-labelledby="consent-title"
  hidden
  class="fixed bottom-4 left-4 z-50 hidden max-w-sm rounded-xl border border-border-subtle bg-bg-secondary/95 p-5 shadow-2xl backdrop-blur"
>
  <p id="consent-title" class="text-sm font-medium text-text-primary">Analytics?</p>
  <p class="mt-2 text-sm leading-relaxed text-text-secondary">
    We'd like to use Google Analytics to see which pages get read. It's on this website
    only — never in the app, and never anything about your machines. Nothing is
    measured unless you say yes.
  </p>
  <div class="mt-4 grid grid-cols-2 gap-2">
    <button
      type="button"
      data-consent="granted"
      class="rounded-md border border-border-subtle bg-bg-tertiary px-3 py-2 text-sm text-text-primary transition hover:border-accent-primary/60"
    >
      Accept
    </button>
    <button
      type="button"
      data-consent="denied"
      class="rounded-md border border-border-subtle bg-bg-tertiary px-3 py-2 text-sm text-text-primary transition hover:border-accent-primary/60"
    >
      Reject
    </button>
  </div>
  <a
    href="/privacy"
    class="mt-3 inline-block text-xs text-text-muted transition hover:text-text-secondary"
  >
    What this collects
  </a>
</div>

<script is:inline>
  (function () {
    var box = document.getElementById('consent-notice');
    if (!box || !window.onyxConsent) return;

    // Asked once. The durable control lives on /privacy, because a
    // banner that returns after you've answered it is its own dark
    // pattern — and withdrawal has to be as easy as giving.
    if (window.onyxConsent.read()) return;

    box.hidden = false;
    box.classList.remove('hidden');

    box.addEventListener('click', function (event) {
      var choice = event.target && event.target.getAttribute('data-consent');
      if (!choice) return;
      window.onyxConsent.set(choice);
      box.hidden = true;
      box.classList.add('hidden');
    });
  })();
</script>
