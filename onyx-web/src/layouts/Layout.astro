---
import '../styles/global.css';
import AnalyticsNotice from '../components/AnalyticsNotice.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A macOS overlay for people whose work is spread across machines, agents and pipelines. Always-connected SSH and tmux sessions, plus what's due today, what your sessions are doing, and which pull requests and builds need you — one keystroke away.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Those two come first, and nothing goes above them. Charset has to
         land in the first 1024 bytes for the parser to trust it, and
         without the viewport tag mobile Safari lays the page out against
         a ~980px window and scales the result down — which is what "the
         text is tiny on my phone" actually is. Both were once deleted by
         an edit to the consent block below; putting them above anything
         that can grow is what stops that repeating. -->

    <!-- Consent state. MUST run before the GTM container: a consent
         default set after the container has started is too late to stop
         the first tags. Everything is denied until an affirmative
         choice, so a first-time visitor is measured only by cookieless
         pings — no cookies, no identifiers. -->
    <script is:inline>
      (function () {
        // Versioned so the record says WHAT was agreed to. Bump the
        // version when the categories change and everyone is asked
        // again, rather than a new purpose inheriting an old yes.
        var KEY = 'onyx-consent-v1';
        var LEGACY = 'onyx-analytics';

        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }

        function read() {
          try {
            var raw = localStorage.getItem(KEY);
            if (raw) return JSON.parse(raw);
            // The old opt-out banner recorded "ok" for people who simply
            // never objected. That is not consent, so it is NOT migrated
            // — those visitors are asked properly. A recorded "off" IS
            // honoured: someone who already said no should not be asked
            // again to get the same answer.
            if (localStorage.getItem(LEGACY) === 'off') {
              return { choice: 'denied', at: null, version: 1, migrated: true };
            }
          } catch (e) {
            /* storage blocked — treat as no choice, which denies */
          }
          return null;
        }

        function apply(choice) {
          var on = choice === 'granted' ? 'granted' : 'denied';
          gtag('consent', 'update', {
            ad_storage: on,
            ad_user_data: on,
            ad_personalization: on,
            analytics_storage: on,
            functionality_storage: on,
            personalization_storage: on,
          });
        }

        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'denied',
          personalization_storage: 'denied',
          security_storage: 'granted',
          wait_for_update: 500,
        });

        var stored = read();
        if (stored) apply(stored.choice);

        // Shared by the banner and the control on /privacy, so there is
        // one implementation of "what does consent mean here".
        window.onyxConsent = {
          read: read,
          set: function (choice) {
            var record = {
              choice: choice === 'granted' ? 'granted' : 'denied',
              at: new Date().toISOString(),
              version: 1,
            };
            try {
              localStorage.setItem(KEY, JSON.stringify(record));
            } catch (e) {
              return null;
            }
            apply(record.choice);
            // Withdrawing consent should also take back what was already
            // stored under it. Analytics cookies are host-scoped, so
            // expiring them here is the part the page can actually do.
            if (record.choice === 'denied') {
              document.cookie.split(';').forEach(function (pair) {
                var name = pair.split('=')[0].trim();
                if (name.indexOf('_ga') === 0 || name === '_gid') {
                  document.cookie =
                    name + '=; Max-Age=0; path=/; domain=.' + location.hostname;
                  document.cookie = name + '=; Max-Age=0; path=/';
                }
              });
            }
            return record;
          },
        };
      })();
    </script>

    <!-- Google Tag Manager. Loads for everyone, but under the consent
         defaults above — denied means no cookies and no identifiers, so
         the container being present is not itself measurement. Blocking
         the container outright until acceptance is the stricter reading;
         it is one `if` away, and costs the cookieless traffic counts. -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-T88HLJZP');
    </script>
    <!-- End Google Tag Manager -->

    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.almostrealism.ai" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-bg-primary text-text-primary antialiased">
    <!-- GTM's noscript iframe is deliberately absent. It fires the
         container for visitors with JavaScript off — who cannot be shown
         a consent prompt, and therefore cannot have consented. Measuring
         exactly the people who can't be asked is the wrong side of this
         to be on. -->

    <slot />
    <AnalyticsNotice />
  </body>
</html>
