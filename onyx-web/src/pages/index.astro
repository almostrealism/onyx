---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Overlay from '../components/sections/Overlay.astro';
import Work from '../components/sections/Work.astro';
import Agents from '../components/sections/Agents.astro';
import Everywhere from '../components/sections/Everywhere.astro';
import Alerts from '../components/sections/Alerts.astro';
import Connection from '../components/sections/Connection.astro';
import Features from '../components/sections/Features.astro';
import Download from '../components/sections/Download.astro';
import Footer from '../components/sections/Footer.astro';
---

<Layout
  title="Onyx — mission control for your agents, PRs and pipelines"
  description="A macOS overlay that watches every Claude on every machine, every open pull request and its CI, and every pipeline at once, and shows which one needs you. Over SSH terminals that stay connected."
>
  <main>
    <Hero />
    <Overlay />
    <Work />
    <Agents />
    <Everywhere />
    <Alerts />
    <Connection />
    <Features />
    <Download />
  </main>
  <Footer />
</Layout>
