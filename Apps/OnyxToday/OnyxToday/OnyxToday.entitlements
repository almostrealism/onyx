<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The keychain group the Mac app shares, FIRST: SecretStore writes to the
	     default group, which is the first listed. The Mac's entitlements must
	     list the same group first for the Onyx key and the home host to reach
	     this app through iCloud Keychain (docs/ios-plan.md). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.onyx.shared</string>
	</array>
</dict>
</plist>
